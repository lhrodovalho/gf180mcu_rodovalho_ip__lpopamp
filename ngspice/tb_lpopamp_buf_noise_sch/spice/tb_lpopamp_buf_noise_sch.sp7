* num: 7 corner: sf vdd: 3 temp: 85

* Include models
.include $PDK_ROOT/$PDK/libs.tech/ngspice/design.ngspice
.lib $PDK_ROOT/$PDK/libs.tech/ngspice/sm141064.ngspice sf
.lib $PDK_ROOT/$PDK/libs.tech/ngspice/sm141064.ngspice mimcap_typical

* no monte carlo
.param
+  sw_stat_global = 0
+  sw_stat_mismatch = 0

.temp 85

.include ../../netlists/lpopamp.sch.spice

* Simulation parameters
.param xavdd  = 3
.param xavss  = 0
.param xen    = 1
.param xvin   = {3/2}
.param xvout  = {3/2}

.param xavdd_ac = 0
.param xvin_ac  = 1
.param xvout_ac = 0

.param xibias = 4u

.param xcl    = 30p
.param xrl    = 1T

* Design under test
*.subckt lpopamp  im  ip  o  avdd  avss  vsub  en  enb  ibias
Xdut out in out avdd  avss  avss  en  enb  ibias lpopamp

v_avss GND avss xavss
v_avdd avdd avss dc {xavdd} ac {xavdd_ac} 
v_in in avss dc {xvin} ac {xvin_ac} 
v_en en avss {xen*xavdd} 
v_enb enb avss {(1-xen)*xavdd} 
i_ibias avdd ibias {xen*xibias} 
CL out avss 'xcl' m=1 

* Simulation control
.option cshunt = 1e-15
.control
  noise v(out) v_in dec 10 1 1G
  let onoise_10k   = noise1.onoise_spectrum[40]
  let onoise_total = noise2.onoise_total
  print onoise_10k onoise_total

  plot noise1.onoise_spectrum loglog
  
  echo "num,corner,vdd,temp,onoise_10k,onoise_total"         >  ./meas/tb_lpopamp_buf_noise_cc.meas7
  echo "7,sf,3,85,$&onoise_10k,$&onoise_total" >> ./meas/tb_lpopamp_buf_noise_cc.meas7

  wrdata ./data/tb_lpopamp_buf_noise_sch_onoise.dat7 noise1.frequency noise1.onoise_spectrum

.endc

.GLOBAL GND 
.end 

