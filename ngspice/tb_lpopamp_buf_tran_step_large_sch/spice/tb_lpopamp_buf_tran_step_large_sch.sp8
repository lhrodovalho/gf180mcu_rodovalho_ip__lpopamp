* num: 8 corner: fs vdd: 3 temp: 85

* Include models
.include $PDK_ROOT/$PDK/libs.tech/ngspice/design.ngspice
.lib $PDK_ROOT/$PDK/libs.tech/ngspice/sm141064.ngspice fs
.lib $PDK_ROOT/$PDK/libs.tech/ngspice/sm141064.ngspice mimcap_typical

* no monte carlo
.param
+  sw_stat_global = 0
+  sw_stat_mismatch = 0

.temp 85

.include ../../netlists/lpopamp.sch.spice

* Simulation parameters
.param xavdd  = 3
.param xavss  = 0
.param xen    = 1
.param xvin   = {xavdd/2}
.param xvout  = {xavdd/2}

.param xavdd_ac = 0
.param xvin_ac  = 0
.param xvout_ac = 0

.param xibias = 10u

.param xcl    = 30p
.param xrl    = 5k

.param xcl    = 30p
.param xrl    = 5k

.param xamp  = {xavdd-100m}
.param xvlo  = {50m}
.param xvhi  = {xavdd-1}
.param xper  = {40u}
.param xtdel = {xper/4}
.param xtr   = {xper/1000}
.param xpw   = {xper/2-xtr}

* Design under test
*.subckt lpopamp  im  ip  o  avdd  avss  vsub  en  enb  ibias
Xdut out in out avdd  avss  avss  en  enb  ibias lpopamp

v_avss GND avss xavss
v_avdd avdd avss dc {xavdd} ac {xavdd_ac} 
v_in in avss pulse({xvlo} {xvhi} {xtdel} {xtr} {xtr} {xpw} {xper}) 
v_en en avss {xen*xavdd} 
v_enb enb avss {(1-xen)*xavdd} 
i_ibias avdd ibias {xen*xibias} 
CL out avss 'xcl' m=1 
v_out out_ avss dc {xvout} ac {xvout_ac} 
RL out out_ 'xrl' m=1 

* Simulation control
.option gmin=1e-12
.option cshunt=1e-15
.option method=Gear
.param xtstart = 0
.param xtend   = {xper}
.param xtstep  = {xper/1000}
.tran {xtstep} {xtend} {xtstart}

.save v(in) v(out)
.control
  run
  plot in out

  let avdd = 3.3
  let vhi  = avdd-1
  let vlo  = 50m
  let vmax = vlo+0.9*(vhi-vlo)
  let vmin = vlo+0.1*(vhi-vlo)
  let dv   = vmax-vmin

  meas tran slewp trig v(out) rise=1 val=vmin targ v(out) rise=1 val=vmax
  meas tran slewm trig v(out) fall=1 val=vmax targ v(out) fall=1 val=vmin

  let slewrp = abs(dv/slewp)
  let slewrm = abs(dv/slewm)
  let slewr  = (slewrp+slewrm)/2

  print slewrp slewrm slewr

  echo "num,corner,vdd,temp,slewrp,slewrm,slewr"           >  ../meas/tb_lpopamp_buf_tran_step_large_cc.meas8
  echo "8,fs,3,85,$&slewrp,$&slewrm,$&slewr" >> ../meas/tb_lpopamp_buf_tran_step_large_cc.meas8

  wrdata ../data/tb_lpopamp_buf_tran_step_large_sch.dat8 v(in) v(out)

.endc

.GLOBAL GND 
.end 

